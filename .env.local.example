# Microsoft Graph API Configuration
# Para obtener estas credenciales:
# 1. Ve a https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# 2. Crea una nueva "App registration"
# 3. En "Authentication", agrega http://localhost:3000 como Redirect URI (SPA)
# 4. En "API permissions", agrega: Files.Read, Files.Read.All, Sites.Read.All
# 5. Copia el "Application (client) ID" como NEXT_PUBLIC_AZURE_CLIENT_ID
# 6. Copia el "Directory (tenant) ID" como NEXT_PUBLIC_AZURE_TENANT_ID

NEXT_PUBLIC_AZURE_CLIENT_ID=tu-client-id-aqui
NEXT_PUBLIC_AZURE_TENANT_ID=tu-tenant-id-aqui

# ID del archivo de Excel en OneDrive/SharePoint
# Formato: https://graph.microsoft.com/v1.0/me/drive/items/{EXCEL_FILE_ID}/workbook/worksheets
NEXT_PUBLIC_EXCEL_FILE_ID=tu-file-id-aqui

# Nombre de la hoja de Excel donde están los datos
NEXT_PUBLIC_EXCEL_SHEET_NAME=Hoja1

# Intervalo de actualización en milisegundos (300000 = 5 minutos)
NEXT_PUBLIC_REFRESH_INTERVAL=300000
